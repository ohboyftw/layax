{
  "name": "banking77-pub",
  "dataset": "banking77",
  "output_dir": "runs/banking77-pub",
  "li": {
    "base_checkpoint": "convaiinnovations/laya",
    "base_subfolder": "typed-decisions",
    "interaction": "maxsim",
    "proj_dim": 128,
    "state_max_len": 512,
    "option_max_len": 24,
    "xattn_heads": 8,
    "xattn_dropout": 0.1,
    "learn_scale": true,
    "init_scale": 20.0,
    "ordinal_score_loss": true,
    "ordinal_weight": 0.3,
    "lr_encoder": 1e-05,
    "lr_head": 0.0001,
    "weight_decay": 0.01,
    "warmup_ratio": 0.06,
    "epochs": 5,
    "batch_size": 8,
    "grad_accum": 4,
    "max_grad_norm": 1.0,
    "amp_dtype": "fp16",
    "freeze_encoder_epochs": 0,
    "seed": 17,
    "rlcd_weight": 0.7,
    "w_sph": 0.5,
    "w_rps": 1.0,
    "in_batch_negatives": true,
    "negative_weight": 0.5,
    "train_options_per_row": 16,
    "option_sampling": "random"
  },
  "comp": {
    "use_pooled": true,
    "use_score_stats": true,
    "use_interaction_stats": true,
    "use_length_stats": true,
    "use_lang_stats": true,
    "use_energy": true,
    "use_mahalanobis": true,
    "hidden": [
      256,
      64
    ],
    "dropout": 0.1,
    "detach_features": true,
    "lr": 0.0003,
    "weight_decay": 0.01,
    "epochs": 8,
    "batch_size": 128,
    "seed": 17,
    "pos_weight_auto": true,
    "shift_truncate": 0.15,
    "shift_truncate_keep": 0.3,
    "shift_foreign": 0.25,
    "shift_distractors": 0.2,
    "shift_distractor_n": 8,
    "shift_ood_domain": 0.15,
    "calibration": "isotonic",
    "target_risk": 0.05,
    "delta": 0.1,
    "min_coverage": 0.3
  },
  "competence_frac": 0.15,
  "calibration_frac": 0.1,
  "eval_batch_size": 32,
  "max_train_rows": null,
  "max_eval_rows": 3000,
  "classifier_baselines": true,
  "competence_head": false,
  "group_by": "language"
}